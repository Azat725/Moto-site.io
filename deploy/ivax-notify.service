# /etc/systemd/system/ivax-notify.service — единственный отправитель уведомлений (Telegram, e-mail)
[Unit]
Description=IV&AX MOTO notifications sender
After=network.target

[Service]
User=ivax
Group=ivax
WorkingDirectory=/srv/ivax/app
EnvironmentFile=/srv/ivax/app/.env
Environment=DJANGO_SETTINGS_MODULE=config.settings.prod
ExecStart=/srv/ivax/app/.venv/bin/python manage.py send_notifications --loop --interval 5
Restart=always
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/ivax/data

[Install]
WantedBy=multi-user.target
