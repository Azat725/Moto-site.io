# /etc/systemd/system/ivax.service — веб-приложение (gunicorn за Caddy)
[Unit]
StartLimitIntervalSec=0
Description=IV&AX MOTO (gunicorn)
After=network.target

[Service]
User=ivax
Group=ivax
WorkingDirectory=/srv/ivax/app
EnvironmentFile=/srv/ivax/app/.env
Environment=DJANGO_SETTINGS_MODULE=config.settings.prod
ExecStart=/srv/ivax/app/.venv/bin/gunicorn config.wsgi:application --bind 127.0.0.1:8000 --workers 3 --timeout 30 --max-requests 1000 --max-requests-jitter 100
Restart=always
RestartSec=5
UMask=0027
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/srv/ivax/data /srv/ivax/media

[Install]
WantedBy=multi-user.target
