# Один раз скопировать в .env. Секреты сгенерировать на VPS; этот файл секретов не содержит.
DJANGO_SECRET_KEY=
IP_HASH_SALT=
ADMIN_PATH=
DJANGO_ALLOWED_HOSTS=ivax-moto.ru,www.ivax-moto.ru
DJANGO_CSRF_TRUSTED_ORIGINS=https://ivax-moto.ru,https://www.ivax-moto.ru
SITE_DOMAIN=https://ivax-moto.ru
CADDY_SITE_ADDRESSES=ivax-moto.ru,www.ivax-moto.ru
SITE_NOINDEX=true
SITE_LOGO=volt
COMPOSE_PROJECT_NAME=ivax
# Менять три параметра вместе только при конфликте с сетью VPS/VPN.
DOCKER_SUBNET=172.30.61.0/24
DOCKER_DYNAMIC_RANGE=172.30.61.128/25
CADDY_CONTAINER_IP=172.30.61.2
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_INCLUDE_PD=false
LEAD_NOTIFY_EMAILS=
EMAIL_HOST=smtp.yandex.ru
EMAIL_PORT=465
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_SSL=true
EMAIL_USE_TLS=false
DEFAULT_FROM_EMAIL=IV&AX MOTO <noreply@ivax-moto.ru>
LEAD_RETENTION_DAYS=1095
