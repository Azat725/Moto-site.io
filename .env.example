# Скопируйте в .env на сервере и заполните. Файл .env в git НЕ коммитится.
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=ivax-moto.ru,www.ivax-moto.ru
DJANGO_CSRF_TRUSTED_ORIGINS=https://ivax-moto.ru,https://www.ivax-moto.ru
SITE_DOMAIN=https://ivax-moto.ru
SITE_NOINDEX=true
SITE_LOGO=volt
# Случайная строка, например результат: python -c "import secrets;print(secrets.token_urlsafe(12))"
ADMIN_PATH=
DATA_DIR=/srv/ivax/data
MEDIA_ROOT=/srv/ivax/media
TRUSTED_PROXY=true
TRUSTED_PROXY_IPS=127.0.0.1,::1
IP_HASH_SALT=
# Telegram: бот и чат менеджеров. TELEGRAM_INCLUDE_PD=true — передавать имя/телефон (трансграничная передача ПДн!)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_API_BASE=https://api.telegram.org
TELEGRAM_INCLUDE_PD=false
# Почта для уведомлений о заявках (российский SMTP-провайдер)
LEAD_NOTIFY_EMAILS=
EMAIL_HOST=smtp.yandex.ru
EMAIL_PORT=465
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_SSL=true
DEFAULT_FROM_EMAIL=IV&AX MOTO <noreply@ivax-moto.ru>
LEAD_RETENTION_DAYS=1095
